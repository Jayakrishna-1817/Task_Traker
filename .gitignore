# Root gitignore for Ethara Full Stack project
# ============================================

# Node modules (both frontend and backend)
node_modules/
**/node_modules/

# Environment files - NEVER commit these
.env
.env.local
.env.development
.env.production
**/.env
**/.env.local
**/.env.production

# Build output
dist/
build/
**/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.suo
*.swp

# Lock files (optional: keep package-lock for reproducibility)
# package-lock.json

# Misc
*.local
dist-ssr/
